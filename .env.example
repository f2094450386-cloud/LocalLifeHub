# ============================================================
# LocalLifeHub AI Customer Service — 模型配置模板
# ============================================================
# 1. 复制此文件为 .env（.env 已加入 .gitignore）
# 2. 填入真实的 API Key
# 3. 加载环境变量（Spring Boot 不会自动读取 .env 文件）：
#
#    IntelliJ IDEA：装 EnvFile 插件 → Run Configuration → EnvFile → 选择 .env
#    命令行 (Git Bash)：set -a && source .env && set +a
#    PowerShell 手动：$env:AI_ACTIVE="deepseek"; $env:DEEPSEEK_API_KEY="sk-..."
#    Windows 永久：  setx AI_ACTIVE deepseek  (重启终端生效)
#
# 4. 启动 Spring Boot，AI 客服会自动读取这些环境变量。
#    注意：修改 AI_ACTIVE 切换模型后需要重启 Spring Boot，不支持运行时热更新。

# 当前使用的模型: deepseek、qwen 或 minimax
AI_ACTIVE=deepseek

# ---------- DeepSeek ----------
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat

# ---------- 千问 (阿里百炼 DashScope) ----------
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=sk-your-qwen-key
QWEN_MODEL=qwen-plus

# ---------- MiniMax ----------
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_API_KEY=sk-your-minimax-key
MINIMAX_MODEL=MiniMax-M1
